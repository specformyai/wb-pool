# ===========================================================================
# wb-pool 环境变量示例
#
# 用法：cp .env.example .env 然后改下面几项。
#
# 这里的每一项都只是「默认值」。绝大多数配置在 WebUI 的「设置 → 运行时配置」
# 里可以直接改，改完立刻生效、不用重启，并且会存进 data/settings.json。
# 优先级：面板设置 > 环境变量 > 代码默认值。
#
# 所以最小可跑配置其实只有两项：WB_API_KEY 和 WB_ADMIN_KEY。
# 剩下的都可以先不管，等服务起来了在面板上填。
# ===========================================================================

# --------------------------------------------------------------- 必填：访问凭据
# 反代访问密钥（客户端拿它当 OpenAI API Key 用）。
# 留空表示不校验 —— 只在本机自己玩时可以留空，暴露到公网必须填。
# 生成：openssl rand -hex 32
WB_API_KEY=change-me-to-a-long-random-string

# 管理接口密钥，给 curl / 脚本用（WebUI 本身走账号密码登录，不用这个）。
# 留空则回落成 WB_API_KEY。**建议单独设一个**：反代 key 会分发给使用者，
# 而管理 key 能读到全部账号 token，两者权限完全不同。
WB_ADMIN_KEY=

# 首次启动创建的管理员账号。不填则是 admin/admin，
# 而服务会锁住除登录/改密以外的所有接口，直到你把默认密码改掉。
WB_ADMIN_USER=admin
WB_ADMIN_PASS=

# --------------------------------------------------------------- 数据与时区
# 数据目录（accounts.jsonl / settings.json / ledger.json 都在这）。
# 相对路径按项目根目录解析，容器里挂卷到 /app/data 即可。
WB_DATA_DIR=./data

# 单独覆盖账号池文件路径（一般不用动，测试隔离时才用）
WB_ACCOUNTS_FILE=

# 时区。签到判重、「今日到账」这些都按本地日算，部署到非东八区的机器上
# 如果不改，日期会整体错一天。
WB_TZ=Asia/Shanghai

# --------------------------------------------------------------- 出口代理
# off=直连（默认，新部署就用这个）| fixed=固定用 WB_PROXY_URL | rotate=在出口表里轮换
#
# rotate 需要本机跑着一组 HTTP 代理（gost / squid / v2ray 之类）。
# 出口表不再写死在代码里 —— 在 WebUI「代理池」页可以手动增删，
# 也可以点「自动探测」扫一段端口自动发现。
WB_PROXY_MODE=off
WB_PROXY_HOST=127.0.0.1
WB_PROXY_URL=

# 出口表的初始值，格式 端口:标签，逗号分隔。留空则为空表（推荐留空，在面板里加）。
# 例：WB_EXITS=61001:RO,61002:US,3128:squid
WB_EXITS=

# --------------------------------------------------------------- 接码平台
# uoomsg 接码平台 token，自动注册要用。
# **推荐留空，在 WebUI「设置 → 接码平台」里填** —— 那样不用把密钥写进文件。
WB_UOOMSG_TOKEN=

# --------------------------------------------------------------- 定时任务
# 每日签到 cron（分 时 日 月 周）
WB_CHECKIN_CRON=5 1 * * *
# 余额刷新间隔（分钟）。测试时填 9999 关掉，别填 0。
WB_BALANCE_INTERVAL_MIN=10

# --------------------------------------------------------------- 调度阈值
# 余额低于这个值、且数据陈旧时，请求前会补一次实时余额校验
WB_VERIFY_BELOW_CREDITS=150
# 余额数据超过这么多秒算陈旧
WB_VERIFY_STALE_SEC=120
# 连续 auth 失败几次就把账号踢出候选池
WB_AUTH_FAIL_LIMIT=2
# 套餐剩余不足这么多小时，算「即将作废」
WB_EXPIRING_SOON_H=72

# --------------------------------------------------------------- 历史对话回溯
# 「历史对话」页从上游用量流水还原聊天记录，这几项控制抓取范围。
# 上游那个接口只认自然月、跨月静默返 0，所以是按月分片抓的。
# 每页条数
WB_HISTORY_PAGE_SIZE=100
# 单个月最多翻多少页（防止号用量极大时无限翻页）
WB_HISTORY_MAX_PAGES=120
# 最早回溯到哪个月。账号 registered_at 不一定有（导入的号），用这个兜底下界，
# 免得无意义地往前扫几十个空月。
WB_HISTORY_FLOOR=2026-01

# --------------------------------------------------------------- Cookie
# auto=有 HTTPS 时自动加 Secure | on=强制 | off=关闭
# 反代在 HTTPS 后面但服务本身跑 HTTP 时，auto 靠 X-Forwarded-Proto 判断
WB_COOKIE_SECURE=auto
