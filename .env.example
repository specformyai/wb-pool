# 反代访问密钥（客户端用它当 OpenAI API Key；留空=不校验，切勿在公网留空）
WB_API_KEY=change-me-to-a-long-random-string
# 管理接口/WebUI 密钥（默认与 WB_API_KEY 相同）
WB_ADMIN_KEY=

# 出口代理：off=直连 | rotate=在 resin 出口里轮换 | fixed=固定用 WB_PROXY_URL
WB_PROXY_MODE=rotate
WB_PROXY_HOST=127.0.0.1
WB_PROXY_URL=

# 数据目录（accounts.jsonl / ledger.json / models_cache.json 都在这）
WB_DATA_DIR=/opt/wb-pool/data

# 每日签到 cron（分 时 日 月 周，Asia/Shanghai）
WB_CHECKIN_CRON=5 1 * * *
# 余额刷新间隔（分钟）
WB_BALANCE_INTERVAL_MIN=30
